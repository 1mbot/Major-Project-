// GPS UART INTERRUPT CALLBACK
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART2)
    {
        if (gps_rx == '\n')
        {
            gps_line[gps_idx] = '\0';
            gps_line_ready = 1;
            gps_idx = 0;
        }
        else
        {
            if (gps_idx < 127)
            {
                gps_line[gps_idx++] = gps_rx;
            }
        }
        HAL_UART_Receive_IT(&huart2, &gps_rx, 1);
    }
}
