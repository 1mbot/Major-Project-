void set_mux(uint8_t ch)
{
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0, (ch & 1)?GPIO_PIN_SET:GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, (ch & 2)?GPIO_PIN_SET:GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, (ch & 4)?GPIO_PIN_SET:GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, (ch & 8)?GPIO_PIN_SET:GPIO_PIN_RESET);
}

// SAFE GPS PARSER
void parse_gps(void)
{
    if (strncmp(gps_line, "$GPRMC", 6) == 0 || strncmp(gps_line, "GPRMC", 5) == 0)
    {
        int comma_count = 0;
        char *p = gps_line;
        char lats[16] = {0}, lons[16] = {0};
        char ns = 'N', ew = 'E';

        while (*p)
        {
            if (*p == ',')
            {
                comma_count++;
                p++;
                if (comma_count == 3)
                {
                    int i = 0;
                    while (*p != ',' && *p != '\0' && i < 15) lats[i++] = *p++;
                    lats[i] = '\0';
                    continue;
                }
                else if (comma_count == 4 && *p != ',') ns = *p;
                else if (comma_count == 5)
                {
                    int i = 0;
                    while (*p != ',' && *p != '\0' && i < 15) lons[i++] = *p++;
                    lons[i] = '\0';
                    continue;
                }
                else if (comma_count == 6 && *p != ',') ew = *p;
            }
            else
            {
                p++;
            }
        }

        if (strlen(lats) > 0 && strlen(lons) > 0)
        {
            float raw = atof(lats);
            int deg = (int)(raw / 100);
            float mins = raw - deg * 100;
            lat = deg + mins / 60.0f;
            if (ns == 'S') lat = -lat;

            raw = atof(lons);
            deg = (int)(raw / 100);
            mins = raw - deg * 100;
            lon = deg + mins / 60.0f;
            if (ew == 'W') lon = -lon;
        }
    }
}

// BMP280 Setup
#define BMP280_ADDR (0x76 << 1)
#define MPU6050_ADDR (0x68 << 1)

uint16_t dig_T1; int16_t dig_T2, dig_T3;
uint16_t dig_P1; int16_t dig_P2, dig_P3, dig_P4, dig_P5, dig_P6, dig_P7, dig_P8, dig_P9;
int32_t t_fine;

void BMP280_Init()
{
    uint8_t cal[24];
    HAL_I2C_Mem_Read(&hi2c1, BMP280_ADDR, 0x88, 1, cal, 24, 100);

    dig_T1 = cal[1]<<8 | cal[0]; dig_T2 = cal[3]<<8 | cal[2]; dig_T3 = cal[5]<<8 | cal[4];
    dig_P1 = cal[7]<<8 | cal[6]; dig_P2 = cal[9]<<8 | cal[8]; dig_P3 = cal[11]<<8 | cal[10];
    dig_P4 = cal[13]<<8 | cal[12]; dig_P5 = cal[15]<<8 | cal[14]; dig_P6 = cal[17]<<8 | cal[16];
    dig_P7 = cal[19]<<8 | cal[18]; dig_P8 = cal[21]<<8 | cal[20]; dig_P9 = cal[23]<<8 | cal[22];

    uint8_t ctrl = 0x27;
    HAL_I2C_Mem_Write(&hi2c1, BMP280_ADDR, 0xF4, 1, &ctrl, 1, 100);
}

void BMP280_ReadTempPress(float *temp, float *press)
{
    uint8_t d[6];
    HAL_I2C_Mem_Read(&hi2c1, BMP280_ADDR, 0xF7, 1, d, 6, 100);

    int32_t adc_P = ((d[0]<<12)|(d[1]<<4)|(d[2]>>4));
    int32_t adc_T = ((d[3]<<12)|(d[4]<<4)|(d[5]>>4));
    int32_t var1, var2;

    var1 = ((((adc_T>>3) - ((int32_t)dig_T1<<1))) * ((int32_t)dig_T2)) >> 11;
    var2 = (((((adc_T>>4) - ((int32_t)dig_T1)) * ((adc_T>>4) - ((int32_t)dig_T1))) >> 12) * ((int32_t)dig_T3)) >> 14;
    t_fine = var1 + var2;

    float T = (t_fine * 5 + 128) >> 8;
    *temp = T / 100.0f;

    int64_t pvar1, pvar2, p;
    pvar1 = ((int64_t)t_fine) - 128000;
    pvar2 = pvar1 * pvar1 * dig_P6;
    pvar2 += (pvar1 * dig_P5) << 17;
    pvar2 += ((int64_t)dig_P4) << 35;
    pvar1 = ((pvar1 * pvar1 * dig_P3) >> 8) + ((pvar1 * dig_P2) << 12);
    pvar1 = ((((int64_t)1 << 47) + pvar1)) * dig_P1 >> 33;

    if(pvar1 == 0) { *press = 0; return; }

    p = 1048576 - adc_P;
    p = (((p << 31) - pvar2) * 3125) / pvar1;
    pvar1 = (dig_P9 * (p >> 13) * (p >> 13)) >> 25;
    pvar2 = (dig_P8 * p) >> 19;
    p = ((p + pvar1 + pvar2) >> 8) + (((int64_t)dig_P7) << 4);

    *press = (float)p / 25600.0f;
}

void MPU6050_Init()
{
    uint8_t val = 0;
    HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR, 0x6B, 1, &val, 1, 100);
}

void MPU6050_Read(float *ax,float *ay,float *az,float *gx,float *gy,float *gz)
{
    uint8_t d[14];
    HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR, 0x3B, 1, d, 14, 100);

    int16_t raX = (d[0]<<8)|d[1]; int16_t raY = (d[2]<<8)|d[3]; int16_t raZ = (d[4]<<8)|d[5];
    int16_t rgX = (d[8]<<8)|d[9]; int16_t rgY = (d[10]<<8)|d[11]; int16_t rgZ = (d[12]<<8)|d[13];

    *ax = raX / 16384.0f; *ay = raY / 16384.0f; *az = raZ / 16384.0f;
    *gx = rgX / 131.0f; *gy = rgY / 131.0f; *gz = rgZ / 131.0f;
}
